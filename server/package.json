{
  "name": "f1-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "concurrently -n API,WEB -c blue,green \"npm run dev\" \"npm --prefix ../client run dev\"",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "test": "playwright test",
    "insert": "cd lib/insert && node index.js",
    "insert:circuit-svgs": "node lib/insert/circuitSvgs.js",
    "scrap": "cd lib/scrap && node index.js",
    "populate": "node lib/populate/index.js"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.8",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.43.1",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "concurrently": "^10.0.4",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.1",
    "playwright": "^1.45.3",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
